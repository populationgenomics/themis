# proto-file: themis/widgets/models/checklist.proto
# proto-message: themis.widgets.models.Checklist
#
# Items that cite a paper: one with a quote, one naming the paper only, one citing nothing.
# The papers are the fixture corpus's, so a citation opens in the document pane.

items {
  id: "regulatory-finding"
  label: "The regulatory finding holds in the cited paper"
  citation {
    doc_id: "11111111-1111-4111-8111-111111111111"
    quote: "The tab strip lists this paper"
  }
}
items {
  id: "scanned-source"
  label: "The scanned source supports the finding"
  citation {
    doc_id: "22222222-2222-4222-8222-222222222222"
  }
}
items {
  id: "uncited"
  label: "An item with no citation"
}
